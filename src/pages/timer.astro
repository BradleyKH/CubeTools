---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TimerApp from '@/components/tools/timer/TimerApp';
---

<BaseLayout
  title="Timer"
  description="A speedcubing timer with WCA inspection, +2 and DNF penalties, ao5, ao12, and ao100 averages, random-state scrambles, and sessions saved in your browser."
>
  <TimerApp client:only="react">
    <div slot="fallback" class="mx-auto max-w-5xl px-4 py-6">
      <h1 class="text-2xl font-bold">Timer</h1>
      <p class="mt-4 text-muted-foreground">Loading the timer...</p>
      <noscript><p class="mt-2">The timer needs JavaScript.</p></noscript>
    </div>
  </TimerApp>
</BaseLayout>
