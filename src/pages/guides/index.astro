---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';

const guides = (await getCollection('guides')).sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Guides" description="Guides to cubing methods and choosing a speedcube.">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="mb-2 text-3xl font-bold tracking-tight">Guides</h1>
    <p class="mb-8 text-muted-foreground">Background reading to help you pick a method and a cube.</p>
    <ul class="grid gap-3 sm:grid-cols-2">
      {guides.map((g) => (
        <li>
          <a href={withBase(`guides/${g.id.replace(/\.(mdx?)$/, '')}/`)} class="block h-full rounded-lg border bg-card p-4 hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring">
            <span class="block text-lg font-semibold">{g.data.title}</span>
            <span class="mt-1 block text-sm text-muted-foreground">{g.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
