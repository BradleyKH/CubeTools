---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';
---

<BaseLayout title="Scrambler" description="A scramble generator is being rebuilt for Cube Tools.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold">Scrambler</h1>
    <p class="mt-4 text-muted-foreground">The Cube Tools scrambler is being rebuilt and will be back soon.</p>
    <p class="mt-6"><a class="text-link underline" href={withBase('')}>Back to home</a></p>
  </div>
</BaseLayout>
