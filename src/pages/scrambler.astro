---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScramblerApp from '@/components/tools/scrambler/ScramblerApp';
---

<BaseLayout
  title="Scrambler"
  description="Generate official-style random-state scrambles for 3x3, 2x2, 4x4 through 7x7, Pyraminx, Skewb, Megaminx, Clock, and Square-1, with a diagram of each scramble."
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-bold">Scrambler</h1>
    <p class="mt-2 mb-8 text-muted-foreground">Random-state scrambles for every WCA puzzle, with a picture of each one.</p>
    <ScramblerApp client:load />
  </div>
</BaseLayout>
