---
import CubeView from '@/components/CubeView.astro';
import { normalizeAlg } from '@/lib/cube';

export interface Props {
  alg: string;
  name?: string;
  alts?: string[];
  showCube?: boolean;
  stickering?: string;
  puzzle?: string;
}

const { alg, name, alts = [], showCube = false, stickering, puzzle = '3x3x3' } = Astro.props;
const main = normalizeAlg(alg);
const alternates = alts.map(normalizeAlg);
const cubePuzzle = puzzle as '3x3x3' | '2x2x2' | '4x4x4' | '5x5x5';
---

<div class="alg-block not-prose my-6 flex flex-wrap items-start gap-4 rounded-lg border bg-card p-4 text-card-foreground">
  {showCube && (
    <CubeView
      puzzle={cubePuzzle}
      alg={main}
      setupFromAlgInverse
      stickering={stickering}
      view="2D"
      size="sm"
      label={`${name ?? 'Algorithm'} case, before applying ${main}`}
    />
  )}
  <div class="min-w-56 flex-1">
    {name && <p class="mb-1 text-sm font-semibold">{name}</p>}
    <div class="flex items-start gap-2">
      <code class="alg min-w-0 flex-1 break-words text-base">{main}</code>
      <button
        type="button"
        data-copy={main}
        class="shrink-0 rounded border px-2 py-1 text-xs hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring"
        aria-label={`Copy algorithm${name ? ` ${name}` : ''}`}
      >
        Copy
      </button>
    </div>
    {alternates.length > 0 && (
      <div class="mt-3 text-sm">
        <p class="text-muted-foreground">Alternates</p>
        <ul class="mt-1 space-y-1">
          {alternates.map((a) => (
            <li>
              <code class="alg">{a}</code>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</div>

<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-copy]');
    if (!button) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => (button.textContent = 'Copy'), 1500);
  });
</script>
