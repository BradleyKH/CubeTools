---
import { withBase } from '@/lib/url';
import { site } from '@/data/site';
---

<footer class="mt-16 border-t border-border text-sm text-muted-foreground">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {new Date().getFullYear()} {site.author}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      <li><a class="underline underline-offset-2 hover:text-foreground" href={withBase('resources/')}>Resources</a></li>
      <li><a class="underline underline-offset-2 hover:text-foreground" href={site.repoUrl}>GitHub</a></li>
    </ul>
    <p>Not affiliated with Rubik's Brand Ltd.</p>
  </div>
</footer>
