---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
}

const { src, alt, caption, width } = Astro.props;
---

<figure class="my-6">
  <Image src={src} alt={alt} width={width ?? Math.min(src.width, 800)} class="h-auto max-w-full rounded-lg border" />
  {caption && <figcaption class="mt-2 text-sm text-muted-foreground">{caption}</figcaption>}
</figure>
