---
import { nav } from '@/data/nav';
import { withBase } from '@/lib/url';

const current = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('?') && withBase(href) === current;
const linkClass =
  'block rounded-md px-3 py-2 text-base hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none aria-[current=page]:font-semibold aria-[current=page]:text-link';
---

<div class="md:hidden" data-mobile-nav>
  <button
    type="button"
    class="inline-flex size-9 items-center justify-center rounded-md hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
  >
    <span class="sr-only">Menu</span>
    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
  <nav
    id="mobile-nav-panel"
    aria-label="Mobile"
    hidden
    class="absolute inset-x-0 top-full z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-border bg-background px-4 py-3 shadow-lg"
  >
    <ul>
      {
        nav.map((item) => (
          <li class="py-1">
            {item.groups ? (
              <>
                <p class="px-3 pt-2 text-sm font-semibold">{item.label}</p>
                {item.groups.map((group) => (
                  <>
                    {group.heading && (
                      <p class="px-3 pt-2 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
                        {group.heading}
                      </p>
                    )}
                    <ul>
                      {group.links.map((link) => (
                        <li>
                          <a
                            href={withBase(link.href)}
                            class={linkClass}
                            aria-current={isCurrent(link.href) ? 'page' : undefined}
                          >
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ))}
              </>
            ) : (
              <a
                href={withBase(item.href)}
                class={`${linkClass} font-semibold`}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const btn = root?.querySelector<HTMLButtonElement>('button[aria-controls]');
  const panel = document.getElementById('mobile-nav-panel');

  if (root && btn && panel) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
  }
</script>
