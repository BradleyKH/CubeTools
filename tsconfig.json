{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs", "vitest.config.ts"],
  "exclude": ["dist", "node_modules", "old"],
  "compilerOptions": {
    "paths": {
